{
  "id": "com.amalia.demo.focusroom",
  "name": "Фокус-комната",
  "version": "1.0.0",
  "author": "amalia",
  "category": "scenario",
  "description": "Тестовый пакет 3.0: тёмная тема «Глубина», приветствия про тишину и сценарий Мишки «25 минут фокуса» — приглушает телефон, будит через 25 минут и возвращает звук.",
  "minHostVersion": "3.0.0",
  "entryPoint": null,
  "themes": [
    {
      "id": "com.amalia.demo.focusroom.depth",
      "name": "Глубина",
      "forceDark": true,
      "preview": {
        "name": "Глубина",
        "stops": [
          { "color": "#04070F", "position": 0.0 },
          { "color": "#0D1B3E", "position": 0.55 },
          { "color": "#02040A", "position": 1.0 }
        ],
        "isDark": true,
        "cct": 8000,
        "melanopicDer": 0.15,
        "auroras": ["#2E4A8F", "#3B2E7A", "#1B2F66"],
        "motif": "STARS",
        "motifAccent": "#9DB8FF",
        "motifAccentAlt": "#C9B8FF",
        "shadow": "#8A020510",
        "sheen": 0.06
      },
      "staticDark": {
        "name": "Глубина",
        "stops": [
          { "color": "#04070F", "position": 0.0 },
          { "color": "#0D1B3E", "position": 0.55 },
          { "color": "#02040A", "position": 1.0 }
        ],
        "isDark": true,
        "cct": 8000,
        "melanopicDer": 0.15,
        "auroras": ["#2E4A8F", "#3B2E7A", "#1B2F66"],
        "motif": "STARS",
        "motifAccent": "#9DB8FF",
        "motifAccentAlt": "#C9B8FF",
        "shadow": "#8A020510",
        "sheen": 0.06
      }
    }
  ],
  "phrases": {
    "ru": [
      "Тихо. Осталось только важное.",
      "Фокус — это свет, наведённый в одну точку.",
      "Мир подождёт двадцать пять минут.",
      "Шум отступает. Начинаем."
    ],
    "en": [
      "Quiet. Only what matters remains.",
      "Focus is light aimed at a single point.",
      "The world can wait twenty-five minutes.",
      "The noise recedes. Let's begin."
    ]
  },
  "scenarios": [
    {
      "id": "focus_25",
      "title": "25 минут фокуса",
      "goal": "Приглушить телефон на 25 минут и вернуть звук в конце",
      "capabilities": ["set_volume", "set_brightness", "notifications.post"],
      "tree": {
        "type": "sequence",
        "children": [
          { "type": "say", "text": "Фокус начался: 25 минут тишины. Приглушила звук и свет." },
          { "type": "action", "tool": "set_volume", "args": { "percent": "20" } },
          { "type": "action", "tool": "set_brightness", "args": { "percent": "35" } },
          { "type": "sleep", "until": { "type": "poll", "intervalMs": "1500000" } },
          { "type": "action", "tool": "set_volume", "args": { "percent": "60" } },
          { "type": "say", "text": "Фокус закончен. Звук вернулся — выдохни и потянись." },
          { "type": "done", "outcome": "Сессия фокуса завершена: 25 минут в тишине" }
        ]
      }
    }
  ]
}
